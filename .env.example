# Flask
FLASK_APP=wsgi:app
FLASK_DEBUG=1
# Isi dengan string acak minimal 32 karakter (production: wajib diganti)
SECRET_KEY=

# Database lokal (di Docker Compose, DATABASE_URL di-override menuju service mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=foodloop
MYSQL_USER=foodloop
MYSQL_PASSWORD=
DATABASE_URL=mysql+pymysql://foodloop:@localhost:3306/foodloop?charset=utf8mb4

# Password root untuk container MySQL 8 (docker-compose.yml)
MYSQL_ROOT_PASSWORD=

# Keamanan & upload (MB)
SESSION_COOKIE_SECURE=false
MAX_CONTENT_LENGTH_MB=16        
